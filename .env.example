PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# SMTP settings for sending real verification emails.
# If left unset, the server runs in "dev mode": it logs the
# verification link to the console (and returns it in the API
# response) instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Alfaaz <no-reply@alfaaz.example.com>"
